# ── MediaFlow · Configurazione ambiente ──────────────────────────────
APP_NAME=MediaFlow
APP_ENV=development
SECRET_KEY=P8CSn3p1rJjG_D2gbPk3NcLOa6dtVEBN7n3IJrTeWMhnbpeFxePfJ8XbQKcA2wOs
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./mediaflow.db

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

# Server
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────────────────────
#  AI PROVIDER — scegli uno: claude | openai | ollama | disabled
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=disabled

# Anthropic Claude (opzione raccomandata)
# Modelli disponibili (Apr 2026): claude-opus-4-7 (top), claude-sonnet-4-6 (default
# bilanciato), claude-haiku-4-5 (rapido/economico). Sostituibile via UI Impostazioni.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (alternativa equivalente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama locale (nessun costo, richiede GPU consigliata)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# ─────────────────────────────────────────────────────────────
#  WEB SEARCH — Tavily (ricerca AI-ottimizzata, 1000 query/mese gratis)
#  Registrati su https://tavily.com → dashboard → API Keys
# ─────────────────────────────────────────────────────────────
TAVILY_API_KEY=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
USE_TAVILY=true

