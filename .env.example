# ── MediaFlow · Configurazione ambiente ──────────────────────────────
APP_NAME=MediaFlow
APP_ENV=development
SECRET_KEY=cambia-questa-chiave-segreta-in-produzione
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./mediaflow.db

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200

# Server
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────────────────────
#  AI PROVIDER — fallback globale (claude | openai | gemini | perplexity | ollama | disabled)
#  In v3.2 la configurazione principale è per-utente via /settings → tab AI.
#  Questo blocco resta come fallback se nessun utente ha config personale.
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=disabled

# Anthropic Claude
# Modelli (Apr 2026): claude-opus-4-7 (top), claude-sonnet-4-6 (default), claude-haiku-4-5 (rapido)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Perplexity (sonar-pro per ricerca con citazioni)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Ollama locale (nessun costo, richiede GPU consigliata)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# Cifratura api_key salvate nel DB (per-utente). Genera una volta sola con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Una rotazione di questa chiave invalida tutte le api_key salvate (richiede re-inserimento).
AI_KEY_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
#  WEB SEARCH — Tavily (ricerca AI-ottimizzata, 1000 query/mese gratis)
#  Registrati su https://tavily.com → dashboard → API Keys
# ─────────────────────────────────────────────────────────────
TAVILY_API_KEY=
USE_TAVILY=true

# ── OAuth account linking (Fase A) ──────────────────────────
# OAuth client "Web" da Google Cloud Console, con Calendar API + Drive API
# abilitate e redirect URI: {OAUTH_REDIRECT_BASE_URL}/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# ── Fase D — Google Picker (opzionale) ──────────────────────
# Senza questa chiave l'incolla-link funziona comunque; il bottone
# "Scegli da Drive" resta nascosto.
GOOGLE_PICKER_API_KEY=

# ── Client email (/mail) ─────────────────────────────────────
# Richiede l'API Gmail abilitata nel progetto Google Cloud e gli scope
# gmail.readonly + gmail.compose (richiesti in opt-in da /settings → Account →
# "Collega Gmail"). Nessuna nuova variabile: riusa GOOGLE_OAUTH_CLIENT_ID/SECRET.
