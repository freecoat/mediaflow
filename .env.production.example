# ───────────────────────────────────────────────────────────────────
# Claqo — variabili PRODUZIONE (copia in .env e compila). v3.5.0-alpha.172.171
# NON committare .env. Genera i segreti con i comandi indicati.
# ───────────────────────────────────────────────────────────────────

APP_ENV=production
# Auth fail-closed: in produzione DEVE essere true (niente fallback primo-admin).
AUTH_REQUIRED=true

# ── HOSTING A) VPS con Caddy (docker-compose.prod.yml) ──
# DOMAIN deve puntare (A/AAAA) al server, porte 80/443 aperte. Vuoto = IP-only.
DOMAIN=claqo.tuodominio.it
ACME_EMAIL=tu@tuodominio.it

# ── HOSTING B) Self-host ufficio/casa con Cloudflare Tunnel (docker-compose.tunnel.yml) ──
# Token del tunnel "named" creato in Cloudflare Zero Trust (Tunnels). HTTPS +
# hostname gestiti da Cloudflare; nessuna porta aperta sul router.
TUNNEL_TOKEN=

# Segreto firma JWT — genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-secret

# Chiave Fernet per cifrare le API key AI salvate nel DB — genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_KEY_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Admin bootstrap (creato solo al primo boot se il DB è vuoto). CAMBIA la password.
ADMIN_EMAIL=admin@tuodominio.it
ADMIN_PASSWORD=metti-una-password-forte
# BOOTSTRAP_ADMIN=0   # disattiva il bootstrap se gestisci gli utenti a mano

# Database (default: SQLite sul volume /data). Per Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/claqo
DATABASE_URL=sqlite:////data/mediaflow.db
UPLOAD_DIR=/data/uploads

# Durata sessione (minuti) e retention cestino (giorni)
ACCESS_TOKEN_EXPIRE_MINUTES=480
TRASH_RETENTION_DAYS=30

# ── AI (opzionali — la config principale è per-utente nel DB) ──────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=
# TAVILY_API_KEY=

# ── Storage S3-compatibile (opzionale: AWS S3 / R2 / MinIO / Wasabi) ──
# Consigliato in cloud per persistere gli asset fuori dal volume.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=
# AWS_S3_REGION=eu-west-1
